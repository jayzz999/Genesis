# Required — get yours at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# LLM provider: "gemini" (default) or "groq" (free tier, great for dev)
GENESIS_LLM_PROVIDER=gemini

# Optional: Groq (free alternative LLM)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# Dreaming: set to 0 to disable idle dream cycles (saves API calls while developing)
GENESIS_DREAMING=1
GENESIS_IDLE_DREAM_AFTER_S=3600

# Server port (default 8002)
PORT=8002
