# ── LLM Provider ─────────────────────────────────────────────────────
# "development" or "production". Production enforces a real LLM provider,
# explicit CORS/trusted hosts, and API token protection.
GENESIS_ENV=development

# "gemini" (default, best quality), "groq" (free tier), or "mock" (no-key local demo/tests)
GENESIS_LLM_PROVIDER=gemini

# Gemini — https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq — https://console.groq.com (free tier, ~100k tokens/day)
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Rate Limiting ─────────────────────────────────────────────────────
# Hard ceiling on LLM calls per minute across ALL organisms combined.
# 0 = disabled (default). Recommended for Groq free tier: 20
# When the limit is reached, callers wait (sleeping) until the window clears.
GENESIS_MAX_LLM_CALLS_PER_MIN=0

# ── Lifecycle / Heartbeat ─────────────────────────────────────────────
# Set to 0 to disable all organism heartbeats (interval ticks, http polling,
# message checks, idle dreaming). Useful during development and testing.
GENESIS_LIFECYCLE=1

# Minimum seconds between society inbox checks per organism.
# Prevents a broadcast to N organisms from triggering N simultaneous LLM calls.
# Default: 30. Increase if you have many organisms and hit rate limits.
GENESIS_MSG_CHECK_INTERVAL_S=30

# ── Dreaming ──────────────────────────────────────────────────────────
# Set to 0 to disable idle dream cycles entirely (zero extra LLM cost).
GENESIS_DREAMING=1

# Seconds an organism must be idle before a dream cycle is triggered.
# Default: 3600 (1 hour). Lower for faster experimentation.
GENESIS_IDLE_DREAM_AFTER_S=3600

# ── Server ───────────────────────────────────────────────────────────
PORT=8002

# Development reload watches only source directories by default so generated
# runtime state does not cause noisy reload loops.
GENESIS_RELOAD=1
GENESIS_RELOAD_DIRS=backend
GENESIS_RELOAD_EXCLUDES=organisms,approvals,memories,tool_runs,collaborations,mcp_servers,frontend/dist,node_modules,.git,__pycache__,*.db,*.sqlite,*.sqlite3

# Durable production data. The Docker image defaults these to /app/data/*.
# For local development the app defaults to project folders when omitted.
DATABASE_URL=sqlite+aiosqlite:///./genesis.db
GENESIS_STORAGE=organisms
GENESIS_POPULATION_STORAGE=populations
GENESIS_MEMORY_STORAGE=memories
GENESIS_TOOL_SANDBOX_STORAGE=tool_runs
GENESIS_COLLAB_STORAGE=collaborations
GENESIS_IMPROVEMENT_STORAGE=improvements
GENESIS_OPERATOR_STORAGE=operators
GENESIS_APPROVAL_STORAGE=approvals
GENESIS_CONNECTOR_STORAGE=connectors
GENESIS_CONNECTOR_HTTP_ALLOWLIST=
GENESIS_CONNECTOR_WEBHOOK_ALLOWLIST=
GENESIS_CONNECTOR_DEPLOY_ALLOWLIST=
GENESIS_CONNECTOR_BROWSER_ALLOWLIST=
GITHUB_TOKEN=
GENESIS_GITHUB_TOKEN=
GENESIS_GITHUB_REPOSITORIES=
GENESIS_MESSAGE_WEBHOOK_URL=
GENESIS_SLACK_WEBHOOK_URL=
GENESIS_DEPLOY_WEBHOOK_URL=
GENESIS_BROWSER_CONNECTOR_ENABLED=0
GENESIS_BROWSER_CONNECTOR_WEBHOOK_URL=
GENESIS_GOVERNANCE_STORAGE=governance
GENESIS_CAPABILITY_STORAGE=capabilities
GENESIS_INTELLIGENCE_STORAGE=intelligence
GENESIS_RELIABILITY_STORAGE=reliability
GENESIS_WORLD_MODEL_STORAGE=world_model
GENESIS_LIVING_SYSTEMS_STORAGE=living_systems
GENESIS_NERVOUS_SYSTEM_STORAGE=nervous_system

# Comma-separated origins allowed to call the API. Use the exact deployed UI URL
# in production, for example: https://genesis.example.com
GENESIS_CORS_ORIGINS=*

# Comma-separated hostnames accepted by the backend. Use your deployed hostname
# in production, for example: genesis.example.com
GENESIS_TRUSTED_HOSTS=*

# Protect mutating API calls and WebSockets. Required in production.
GENESIS_REQUIRE_API_TOKEN=0
GENESIS_API_TOKEN=replace_with_a_long_random_secret

# Optional local-dev convenience only. Do not bake production secrets into a
# public frontend build. In production, set `localStorage.GENESIS_API_TOKEN`
# in a trusted browser session when the bundled UI needs write access.
VITE_GENESIS_API_TOKEN=
